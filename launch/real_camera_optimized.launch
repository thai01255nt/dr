<launch>
  <!-- Optimized Real Camera Node (C++) for 30fps -->
  <node name="real_camera_node" pkg="cart_teb_test" type="real_camera_node" output="screen">
    <param name="camera_device" value="/dev/video11" />
    <param name="width" value="640" />
    <param name="height" value="480" />
    <param name="fps" value="30" />
    <param name="frame_id" value="camera" />

    <!-- publish_bgr: false = MONO8 (faster, for VINS), true = BGR8 (for color) -->
    <param name="publish_bgr" value="false" />
  </node>

  <!-- Optional: Image view for debugging -->
  <!-- <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/camera/image_raw"/>
  </node> -->
</launch>
