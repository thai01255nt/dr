<launch>
    <node pkg="your_package" type="ld19_airsim_node.py" name="ld19_airsim_node" output="screen">
        <param name="airsim_host" value="localhost"/>
        <param name="vehicle_name" value=""/>
        <param name="lidar_name" value="Ld19"/>
        <param name="frame_id" value="base_laser"/>
        <param name="scan_frequency" value="10"/>
    </node>
</launch>
