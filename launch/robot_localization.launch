<?xml version="1.0"?>
<launch>
  <!--
    Robot Localization Launch File

    Fuses ORB-SLAM3 visual odometry with IMU data from MAVROS

    Inputs:
      - /orb_slam3/odom (nav_msgs/Odometry) - Visual odometry from ORB-SLAM3
      - /mavros/imu/data (sensor_msgs/Imu) - IMU data from MAVROS

    Outputs:
      - /odometry/filtered (nav_msgs/Odometry) - Fused odometry for Cartographer
      - /tf (odom -> base_link transform)

    Features:
      - Automatic fallback to IMU when visual tracking is lost
      - Outlier rejection for unstable visual odometry
      - Smooth continuous odometry output
      - Covariance-aware fusion (important for Cartographer)
  -->

  <!-- Arguments -->
  <arg name="config_file" default="$(find cart_teb_test)/config/robot_localization.yaml" />
  <arg name="output_topic" default="/odometry/filtered" />
  <arg name="enable_debug" default="true" />

  <!-- Robot Localization EKF Node -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization_node" output="screen">

    <!-- Load configuration from YAML file -->
    <rosparam command="load" file="$(arg config_file)" />

    <!-- Remap output topic if needed -->
    <remap from="odometry/filtered" to="$(arg output_topic)" />

    <!-- Enable/disable debug output -->
    <param name="print_diagnostics" value="$(arg enable_debug)" />

  </node>

  <!-- Optional: Visualize in RViz -->
  <!-- Uncomment to launch RViz with odometry visualization -->
  <!--
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find cart_teb_test)/config/robot_localization.rviz" if="$(arg enable_rviz)" />
  -->

  <!-- Optional: Record diagnostic topics for debugging -->
  <!-- Uncomment to record odometry topics for analysis -->
  <!--
  <node pkg="rosbag" type="record" name="odom_recorder"
        args="-o /tmp/robot_localization /orb_slam3/odom /mavros/imu/data /odometry/filtered /diagnostics"
        if="$(arg record_bag)" />
  -->

</launch>
